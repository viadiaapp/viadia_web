{
  "name": "viadia-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Viadia backend API — deployed standalone (e.g. on a VPS), independent of the frontend static build.",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "esbuild index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/index.cjs",
    "start": "node dist/index.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "razorpay": "^2.9.6",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/swagger-ui-express": "^4.1.6",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
