
# CORS: comma-separated list of exact origins allowed to call this API. Omit entirely (or leave
# unset) to allow all origins, which is fine for early testing but should be tightened before
# going live. You need BOTH your web domain(s) AND your native app's own origin -- these are
# genuinely different values, not the same domain:
#   - Web: your actual frontend domain(s), e.g. https://viadia.in,https://www.viadia.in
#   - Native app (Android/iOS via Capacitor): NOT your domain -- Capacitor apps make requests
#     from their own internal origin (commonly https://localhost, but this depends on your
#     capacitor.config.ts's server.androidScheme/iosScheme, which this project doesn't override,
#     so the Capacitor version's own default applies). Don't guess this -- verify it directly:
#     run the app on a device/emulator, connect Chrome's remote debugger
#     (chrome://inspect on desktop Chrome, USB debugging enabled on the device), open the
#     Network tab, trigger any API call in the app, and read the exact Origin request header
#     Chrome shows for that request. Use that exact value here.
# Example combining both: FRONTEND_ORIGIN=https://viadia.in,https://www.viadia.in,https://localhost
FRONTEND_ORIGIN=""

# Cloudflare R2 (S3-compatible object storage) for outfit photos and expense/plan attachments,
# used by server/routes/uploads.ts. Create a bucket and an API token in the Cloudflare dashboard
# (R2 > Manage R2 API Tokens) with Object Read & Write permissions scoped to that bucket.
R2_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="MY_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="MY_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="viadia-uploads"

# Where an uploaded object becomes publicly reachable. Either the bucket's r2.dev public
# development URL (R2 > bucket > Settings > Public Access), or a custom domain mapped to the
# bucket — no trailing slash either way.
R2_PUBLIC_URL_BASE="https://pub-xxxxxxxxxxxx.r2.dev"

# Google Play Developer API (server/routes/googleplay.ts) -- verifies purchases made through
# @capgo/native-purchases on Android. Separate service account from Firebase's, created in Google
# Cloud Console, then linked in Play Console > Users & Permissions with access to this app and
# "View financial data" + "Manage orders and subscriptions" permissions.
GOOGLE_PLAY_PACKAGE_NAME="com.viadia.app"
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH="./google-play-service-account.json"

# Hostinger Mail API (server/services/emailService.ts) -- sends owner_invite emails (both the
# "you've been invited" template for existing accounts, and the "sign up to see your invite"
# template for new ones). Separate token from anything else in this project -- generate one under
# Agentic Mail > API access in the sending mailbox's hPanel sidebar. HOSTINGER_MAILBOX_RESOURCE_ID
# is the AC... resource ID of the mailbox to send from (found via the Mail API's AccountApi, or
# hPanel), not the email address itself.
HOSTINGER_MAIL_API_TOKEN="MY_HOSTINGER_MAIL_API_TOKEN"
HOSTINGER_MAILBOX_RESOURCE_ID="AC_MY_MAILBOX_RESOURCE_ID"
HOSTINGER_SENDER_EMAIL="invites@viadia.in"
HOSTINGER_SENDER_NAME="Viadia"

# Shared MySQL connection (server/services/mysqlPool.ts) -- used by both the destinations
# feature (server/routes/destinations.ts) and the airports feature (server/routes/airports.ts),
# caching destination "about" content/photos and looking up pre-populated airport data
# respectively. If this is the same Hostinger account as the mail API above, it's the DB tied to
# your hosting plan (hPanel > Databases > MySQL Databases); MYSQL_HOST is usually localhost only
# if this server itself runs on Hostinger -- if it runs elsewhere (e.g. a separate VPS), use the
# remote MySQL hostname Hostinger gives you there, and make sure that host's IP is allowed under
# hPanel > Databases > Remote MySQL.
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="MY_MYSQL_USER"
MYSQL_PASSWORD="MY_MYSQL_PASSWORD"
MYSQL_DATABASE="MY_MYSQL_DATABASE"

# GEMINI_API_KEY is also used by server/routes/gemini.ts (itinerary generation) -- shared across
# both features, not specific to destinations.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DeepSeek (platform.deepseek.com) -- fallback AI provider for destination content generation.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# Which provider generates destination "about" content first, and which one is tried if that
# fails. Valid values: "gemini" or "deepseek". Defaults to gemini primary / deepseek fallback if
# left unset.
AI_PROVIDER_PRIMARY="gemini"
AI_PROVIDER_FALLBACK="deepseek"

# Unsplash (unsplash.com/developers) -- register an application to get an Access Key. Used to
# fetch a representative photo per destination.
UNSPLASH_ACCESS_KEY="MY_UNSPLASH_ACCESS_KEY"

# User-submitted destination moderation (server/services/userDestinationsService.ts). A user
# free-typing a place not in the curated list gets queued here for review rather than
# immediately triggering Gemini/Unsplash -- see server/routes/userDestinations.ts.
# Empty/unset = unlimited submissions per user per day.
USER_DESTINATION_SUBMISSIONS_PER_DAY=""

# Shared secret for the admin-only moderation endpoints (approve/reject/pending), passed as the
# X-Admin-Secret header. Stopgap until a real admin UI/auth system exists -- pick a long random
# value. Leaving this unset disables the admin endpoints entirely (they respond 503) rather than
# leaving them open.
ADMIN_API_SECRET=""
