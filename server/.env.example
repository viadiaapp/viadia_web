# Port the API listens on (a VPS reverse proxy, e.g. nginx, typically forwards 443 -> this).
PORT=3000

# Restrict CORS to your deployed frontend origin(s). Leave unset to allow any origin (fine for a
# public API with no cookie-based auth, which is what this is — auth is a Bearer token header).
FRONTEND_ORIGIN=https://viadia.in

# Required for AI itinerary generation (server/routes/gemini.ts).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase project this API's Admin SDK talks to (defaults already match the Viadia project;
# override only if you point this API at a different Firebase project).
FIREBASE_PROJECT_ID=viadia
FIREBASE_DATABASE_ID=(default)

# Path to a downloaded Firebase service-account JSON key (Firebase Console > Project Settings >
# Service Accounts). Required unless the host already provides Application Default Credentials
# some other way (e.g. `gcloud auth application-default login` on the VPS).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Razorpay payment gateway credentials (Razorpay Dashboard > Settings > API Keys / Webhooks).
# RAZORPAY_KEY_ID is also returned to the frontend to open Razorpay Checkout — the other two must
# stay server-only.
RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="MY_RAZORPAY_WEBHOOK_SECRET"

# Optional shared secret gating the admin-only PUT /api/subscriptions/:planId endpoint. Not used by
# the app UI; leave unset to keep that endpoint disabled.
ADMIN_API_SECRET="MY_ADMIN_API_SECRET"
