# Frontend build-time config (Vite). The backend is deployed separately — see server/.env.example
# for its own environment variables (GEMINI_API_KEY, Firebase, Razorpay, etc).

# VITE_BACKEND_API_URL: absolute URL of the deployed backend API (e.g. https://api.viadia.in).
# Required for production builds (frontend on static hosting, backend on its own host/VPS — they
# are different origins). Leave unset for local dev if you're using vite.config.ts's /api dev proxy.
VITE_BACKEND_API_URL="https://api.viadia.in"

# Optional: override the AdSense client/slot IDs baked into src/config/appConfig.json.
VITE_ADSENSE_CLIENT_ID=""
VITE_ADSENSE_SLOT_ID=""
